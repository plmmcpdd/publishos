# Copy to .env.staging or a protected systemd EnvironmentFile. Do not commit its values.
APP_ENV=staging
NODE_ENV=production
HOST=127.0.0.1
PORT=3300
DATABASE_URL="file:/var/lib/publishos-staging/publishos-staging.db"
JWT_SECRET="replace-with-a-unique-32-byte-minimum-secret"
MEDIA_SIGNING_SECRET="replace-with-a-unique-32-byte-minimum-secret"
PUBLIC_BASE_URL="http://127.0.0.1:3300"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:3300"
OPS_BRAIN_BRIDGE_ENABLED=true
OPS_BRAIN_BRIDGE_TOKEN="replace-with-a-unique-32-byte-minimum-bridge-token"
TIKTOK_INTEGRATION_ENABLED=false
BACKGROUND_JOBS_ENABLED=false
METRICS_CRON_ENABLED=false
TIKTOK_RECONCILIATION_CRON_ENABLED=false
TIKTOK_STARTUP_RECONCILIATION_ENABLED=false
