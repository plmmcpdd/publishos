generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Client {
  id                       String                    @id @default(cuid())
  name                     String
  industry                 String?
  active                   Boolean                   @default(true)
  email                    String                    @unique
  password                 String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accountBindings          AccountBinding[]
  contents                 Content[]
  performanceMetrics       PerformanceMetrics[]
  oauthAuthorizationStates OAuthAuthorizationState[]
}

model OAuthAuthorizationState {
  id          String    @id @default(cuid())
  provider    String
  stateHash   String    @unique
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  flow        String
  redirectUri String
  actorId     String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([provider, flow, expiresAt])
  @@index([clientId, expiresAt])
}

model AccountBinding {
  id                      String          @id @default(cuid())
  clientId                String
  client                  Client          @relation(fields: [clientId], references: [id])
  platform                String // tiktok, instagram, facebook, x, youtube
  accountUsername         String
  platformUserId          String?
  username                String?
  accessToken             String?
  refreshToken            String?
  expiresAt               DateTime?
  scope                   String?
  grantedScopes           String? // JSON array: scopes actually returned by platform
  status                  String          @default("active")
  reauthorizationRequired Boolean         @default(false)
  reauthorizationReason   String?
  lastCollectionAttemptAt DateTime?
  lastCollectionSuccessAt DateTime?
  nextCollectionAt        DateTime?
  collectionStatus        String          @default("idle") // idle, collecting, success, error
  collectionErrorCode     String?
  collectionErrorMessage  String?
  businessLocation        String? // JSON string: { country, state, city }
  active                  Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  publishJobs             PublishJob[]
  publishedPosts          PublishedPost[]

  @@unique([clientId, platform, accountUsername])
}

model Content {
  id                      String               @id @default(cuid())
  clientId                String
  client                  Client               @relation(fields: [clientId], references: [id])
  contentRef              String?
  title                   String
  description             String
  caption                 String?
  hashtags                String               @default("")
  videoUrl                String // S3 key or presigned URL
  thumbnailUrl            String?
  aiGenerated             Boolean              @default(false)
  aiTools                 String               @default("")
  platforms               String // JSON string: target platforms
  scheduleAt              DateTime?
  publishedAt             DateTime?
  status                  ContentStatus        @default(pending_review)
  metadata                String? // JSON string: { industry, campaign, content_type }
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  assets                  ContentAsset[]
  publishJobs             PublishJob[]
  complianceResults       String? // JSON string: { copyright, ai_disclosure, platform_policy }
  licenseCheckPassed      Boolean              @default(false)
  licenseCheckedAt        DateTime?
  bannedWordsPassed       Boolean              @default(false)
  bannedWordsCheckedAt    DateTime?
  aiDisclosureConfirmed   Boolean              @default(false)
  aiDisclosureConfirmedAt DateTime?
  clientConfirmedAt       DateTime?
  clientConfirmedBy       String?
  publishLogs             PublishLog[]
  performanceMetrics      PerformanceMetrics[]

  @@unique([clientId, contentRef])
}

model ContentAsset {
  id                  String  @id @default(cuid())
  contentId           String
  content             Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type                String // stock_video, client_owned, ai_generated, music
  source              String? // envato, artgrid, client_direct, runway, etc.
  licenseId           String?
  url                 String
  authorizationDocUrl String?
  description         String?
}

enum ContentStatus {
  pending_review
  rejected
  approved
  published
  failed
  draft
  delivered
}

enum JobStatus {
  pending
  dispatched
  client_confirmed
  uploading
  publishing
  published
  failed
  cancelled
}

model PublishJob {
  id                        String               @id @default(cuid())
  contentId                 String
  content                   Content              @relation(fields: [contentId], references: [id])
  accountBindingId          String
  accountBinding            AccountBinding       @relation(fields: [accountBindingId], references: [id])
  platform                  String
  status                    JobStatus            @default(pending)
  scheduleAt                DateTime?
  publishOptions            String? // JSON string: platform-specific options
  clientToken               String? // short-lived token for client app
  jobToken                  String? // one-time token for status callback
  activeKey                 String?              @unique
  taskTokenJti              String?              @unique
  taskTokenExpiresAt        DateTime?
  taskTokenConsumedAt       DateTime?
  taskDeviceId              String?
  platformPostId            String?
  platformPostUrl           String?
  publishId                 String?              @unique
  publishedAt               DateTime?
  failedAt                  DateTime?
  errorCode                 String?
  errorDetail               String?
  errorMessage              String?
  retryable                 Boolean              @default(false)
  retryCount                Int                  @default(0)
  deviceFingerprint         String?
  screenshotUrl             String?
  deliveryStage             String               @default("send_requested")
  sendRequestedAt           DateTime?
  finalCaption              String?
  aiDisclosureRequired      Boolean              @default(false)
  aiDisclosureMethod        String?
  initializationAttemptedAt DateTime?
  uploadUrl                 String?
  uploadExpiresAt           DateTime?
  uploadedBytes             Int                  @default(0)
  uploadCompletedAt         DateTime?
  inboxDeliveredAt          DateTime?
  lastPlatformStatus        String?
  lastStatusCheckedAt       DateTime?
  nextStatusCheckAt         DateTime?
  statusCheckFailures       Int                  @default(0)
  lastStatusError           String?
  workerLeaseToken          String?
  workerLeaseUntil          DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  history                   JobHistory[]
  publishedPosts            PublishedPost[]
  performanceMetrics        PerformanceMetrics[]

  @@index([status, nextStatusCheckAt])
  @@index([deliveryStage, workerLeaseUntil])
}

model PublishedPost {
  id                 String               @id @default(cuid())
  publishJobId       String
  publishJob         PublishJob           @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  accountBindingId   String
  accountBinding     AccountBinding       @relation(fields: [accountBindingId], references: [id])
  platform           String
  platformPostId     String
  platformPostUrl    String?
  publishedAt        DateTime?
  discoveredAt       DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  status             String               @default("active") // active, deleted, unavailable
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  performanceMetrics PerformanceMetrics[]

  @@unique([platform, platformPostId])
  @@index([publishJobId])
  @@index([accountBindingId])
}

model PerformanceMetrics {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  contentId        String
  content          Content        @relation(fields: [contentId], references: [id])
  publishJobId     String
  publishJob       PublishJob     @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  publishedPostId  String?
  publishedPost    PublishedPost? @relation(fields: [publishedPostId], references: [id], onDelete: SetNull)
  platform         String
  platformPostId   String
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  reach            Int?
  impressions      Int?
  engagementRate   Float?
  completionRate   Float?
  averageWatchTime Float?
  observedAt       DateTime       @default(now())
  collectedAt      DateTime       @default(now())
  metricDate       String
  period           String         @default("daily")
  source           String         @default("tiktok_api")
  rawResponseHash  String?
  createdAt        DateTime       @default(now())

  @@unique([publishedPostId, period, metricDate])
  @@index([clientId, collectedAt])
  @@index([clientId, platform])
  @@index([contentId])
  @@index([publishJobId])
  @@index([publishedPostId])
}

model JobHistory {
  id        String     @id @default(cuid())
  jobId     String
  job       PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String
  changedAt DateTime   @default(now())
  changedBy String? // user_id or system
  notes     String?
}

model Device {
  id           String   @id @default(cuid())
  deviceId     String   @unique // hardware-bound device identifier from client app
  clientId     String?
  lastSeen     DateTime @default(now())
  online       Boolean  @default(false)
  capabilities String   @default("") // JSON string: tiktok_web, instagram_web, etc.
  token        String   @unique // device_token for queue polling
  createdAt    DateTime @default(now())
}

model PublishLog {
  id                      String    @id @default(cuid())
  contentId               String
  content                 Content   @relation(fields: [contentId], references: [id])
  contentTitle            String
  userId                  String
  userEmail               String
  platform                String
  licenseCheckPassed      Boolean
  bannedWordsPassed       Boolean
  aiDisclosureConfirmed   Boolean
  licenseCheckedAt        DateTime?
  bannedWordsCheckedAt    DateTime?
  aiDisclosureConfirmedAt DateTime?
  action                  String
  status                  String
  errorCode               String?
  errorMessage            String?
  tiktokPostUrl           String?
  tiktokPostId            String?
  clientIp                String?
  userAgent               String?
  deviceId                String?
  sessionId               String?
  timestamp               DateTime  @default(now())

  @@index([contentId])
  @@index([userId])
  @@index([timestamp])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // create_content, approve_content, publish_job, etc.
  actorId    String? // who did it
  actorType  String // user, system, client_app
  targetType String // content, publish_job, account
  targetId   String
  details    String?
  deviceId   String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ---- GEO Diagnostic System ----

model Ticket {
  id           String   @id @default(cuid())
  companyName  String
  address      String
  website      String?
  industry     String
  phone        String?
  painPoints   String?
  status       String   @default("pending") // pending → diagnosing → completed → delivered
  priority     String   @default("normal")
  assignedTo   String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos    TicketPhoto[]
  diagnosis DiagnosisReport?
}

model TicketPhoto {
  id        String   @id @default(cuid())
  ticketId  String
  url       String
  caption   String?
  type      String   @default("other")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model DiagnosisReport {
  id              String   @id @default(cuid())
  ticketId        String   @unique
  status          String   @default("draft")
  somScore        Float?
  somChatgpt      Float?
  somGemini       Float?
  somPerplexity   Float?
  scoreGmb        Float?
  scoreWeb        Float?
  scoreContent    Float?
  scoreTrust      Float?
  scoreLocal      Float?
  aiSearchResults Json?
  coreFindings    Json?
  competitors     Json?
  recommendations Json?
  revenueImpact   Json?
  summary         String?
  fullReport      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
