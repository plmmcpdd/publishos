generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Client {
  id              String           @id @default(cuid())
  name            String
  industry        String?
  active          Boolean          @default(true)
  email           String           @unique
  password        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accountBindings AccountBinding[]
  contents        Content[]
}

model AccountBinding {
  id                String       @id @default(cuid())
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id])
  platform          String       // tiktok, instagram, facebook, x, youtube
  accountUsername   String
  platformUserId    String?
  username          String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  status            String       @default("active")
  businessLocation  String?      // JSON string: { country, state, city }
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  publishJobs       PublishJob[]
  
  @@unique([clientId, platform, accountUsername])
}

model Content {
  id                String          @id @default(cuid())
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id])
  title             String
  description       String
  caption           String?
  hashtags          String          @default("")
  videoUrl          String          // S3 key or presigned URL
  thumbnailUrl      String?
  aiGenerated       Boolean         @default(false)
  aiTools           String          @default("")
  platforms         String          // JSON string: target platforms
  scheduleAt        DateTime?
  publishedAt       DateTime?
  status            ContentStatus   @default(pending_review)
  metadata          String?         // JSON string: { industry, campaign, content_type }
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assets            ContentAsset[]
  publishJobs       PublishJob[]
  complianceResults String?         // JSON string: { copyright, ai_disclosure, platform_policy }
  licenseCheckPassed Boolean        @default(false)
  licenseCheckedAt   DateTime?
  bannedWordsPassed  Boolean        @default(false)
  bannedWordsCheckedAt DateTime?
  aiDisclosureConfirmed Boolean     @default(false)
  aiDisclosureConfirmedAt DateTime?
  publishLogs       PublishLog[]
}

model ContentAsset {
  id            String  @id @default(cuid())
  contentId     String
  content       Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type          String  // stock_video, client_owned, ai_generated, music
  source        String? // envato, artgrid, client_direct, runway, etc.
  licenseId     String?
  url           String
  authorizationDocUrl String?
  description   String?
}

enum ContentStatus {
  pending_review
  rejected
  approved
  published
  failed
  draft
  delivered
}

enum JobStatus {
  pending
  dispatched
  client_confirmed
  uploading
  publishing
  published
  failed
  cancelled
}

model PublishJob {
  id                  String         @id @default(cuid())
  contentId           String
  content             Content        @relation(fields: [contentId], references: [id])
  accountBindingId    String
  accountBinding      AccountBinding @relation(fields: [accountBindingId], references: [id])
  platform            String
  status              JobStatus      @default(pending)
  scheduleAt          DateTime?
  publishOptions      String?        // JSON string: platform-specific options
  clientToken         String?        // short-lived token for client app
  jobToken            String?        // one-time token for status callback
  platformPostId      String?
  platformPostUrl     String?
  publishId           String?
  publishedAt         DateTime?
  failedAt            DateTime?
  errorCode           String?
  errorDetail         String?
  errorMessage        String?
  retryable           Boolean         @default(false)
  retryCount          Int             @default(0)
  deviceFingerprint   String?
  screenshotUrl       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  history             JobHistory[]
}

model JobHistory {
  id          String     @id @default(cuid())
  jobId       String
  job         PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime   @default(now())
  changedBy   String?    // user_id or system
  notes       String?
}

model Device {
  id          String   @id @default(cuid())
  deviceId    String   @unique // hardware-bound device identifier from client app
  clientId    String?
  lastSeen    DateTime @default(now())
  online      Boolean  @default(false)
  capabilities String  @default("") // JSON string: tiktok_web, instagram_web, etc.
  token       String   @unique // device_token for queue polling
  createdAt   DateTime @default(now())
}

model PublishLog {
  id                      String   @id @default(cuid())
  contentId               String
  content                 Content  @relation(fields: [contentId], references: [id])
  contentTitle            String
  userId                  String
  userEmail               String
  platform                String
  licenseCheckPassed      Boolean
  bannedWordsPassed       Boolean
  aiDisclosureConfirmed   Boolean
  licenseCheckedAt        DateTime?
  bannedWordsCheckedAt    DateTime?
  aiDisclosureConfirmedAt DateTime?
  action                  String
  status                  String
  errorCode               String?
  errorMessage            String?
  tiktokPostUrl           String?
  tiktokPostId            String?
  clientIp                String?
  userAgent               String?
  deviceId                String?
  sessionId               String?
  timestamp               DateTime @default(now())

  @@index([contentId])
  @@index([userId])
  @@index([timestamp])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // create_content, approve_content, publish_job, etc.
  actorId     String?  // who did it
  actorType   String   // user, system, client_app
  targetType  String   // content, publish_job, account
  targetId    String
  details     String?
  deviceId    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
